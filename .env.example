# Server-only runtime values. Configure production values in Sites secrets.
RATE_LIMIT_SALT=replace-with-a-random-secret
PUBLIC_FORM_ORIGIN=https://7madybar.github.io
TEAM_CODE_PEPPER=replace-with-at-least-32-random-characters
INITIAL_ADMIN_EMAIL=your-admin-identifier@example.com
INITIAL_ADMIN_CODE_HASH=replace-with-the-HMAC-SHA256-hash-of-the-admin-code

# Optional one-use owner recovery. Leave absent/empty during normal operation.
# Configure only through authorized hosting administration, then remove after use.
OWNER_RECOVERY_ID=
OWNER_RECOVERY_PROOF=
OWNER_RECOVERY_EXPIRES_AT=
